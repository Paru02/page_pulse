# ---------------------------------------------------------------------------
# Page Pulse - Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# CORS - comma separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Outbound HTTP fetch behaviour
FETCH_TIMEOUT_MS=8000
FETCH_MAX_REDIRECTS=5
FETCH_MAX_CONTENT_BYTES=5242880
USER_AGENT=PagePulse-Bot/1.0 (+https://digitalheroes.example/page-pulse)

# Concurrency: max simultaneous outbound audits processed at once,
# independent of how many HTTP requests are queued at the Express layer.
MAX_CONCURRENT_AUDITS=10

# Broken link checking (bonus feature)
CHECK_BROKEN_LINKS=true
MAX_LINKS_TO_CHECK=15
BROKEN_LINK_TIMEOUT_MS=4000

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Caching
CACHE_TTL_SECONDS=300
# If REDIS_URL is unset or unreachable, Page Pulse automatically falls back
# to an in-memory NodeCache instance so the service still runs.
REDIS_URL=
